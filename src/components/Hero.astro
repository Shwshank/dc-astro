---
import { Image } from "astro:assets";
import heroImage from "../assets/images/delhi_hero.webp";
---

<section class="hero">
  <div class="container">
    <div class="hero-wrapper">
      <div class="hero-image">
        <Image
          src={heroImage}
          alt="Delhi city orientation walk with a local companion"
          loading="eager"
          decoding="async"
          height={230}
          width={409}
        />
      </div>

      <div class="hero-text">
        <h1>Arriving in India for the first time?</h1>

        <p>
          Delhi Concierge helps you understand how daily life works in Delhi —
          from payments and transport to social etiquette — so you can navigate
          the city comfortably.
        </p>

        <a href="/navigate-delhi"  class="btn"> Navigation in Delhi </a>
      </div>
    </div>
  </div>
</section>
