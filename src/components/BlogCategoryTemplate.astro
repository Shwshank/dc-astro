---
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "./Pagination.astro";
import CTA from "./CTA.astro";
import { Image } from "astro:assets";

const {
    category,
    description,
    posts,
    currentPage,
    totalPages,
    breadcrumb = [],
    showCTA = false,
    heroImage = null,
} = Astro.props;
---

<BaseLayout title={`${category} | Delhi Concierge`}>
    <section class="category-container">
        <!-- BREADCRUMB -->
        {
            breadcrumb.length > 0 && (
                <div class="breadcrumb">
                    {breadcrumb.map((item: any, i: any) => (
                        <>
                            {i !== 0 && <span>›</span>}
                            {item.href ? (
                                <a href={item.href}>{item.label}</a>
                            ) : (
                                <span class="current">{item.label}</span>
                            )}
                        </>
                    ))}
                </div>
            )
        }

        <!-- HERO -->
        <!-- HERO -->
<div class="category-hero glass">

    <div class="hero-media">
        <Image 
            src={heroImage} 
            alt={category}
            widths={[400, 800, 1200, 1600]}
            sizes="(max-width: 768px) 100vw, 1200px"
            format="avif"
            quality={80}
        />
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>{category}</h1>
        <p class="category-desc">{description}</p>
    </div>

</div>

        <!-- BLOG GRID -->
        <!-- BLOG GRID -->
<div class="blog-grid-wrapper">
    <div class="grid-bg"></div>

<div class="blog-grid">
    {(posts || []).map((post:any) => (
        <a href={post.href} class="blog-card glass">

            {post.image && (
                <div class="card-image">
                    <Image src={post.image} alt={post.title} />
                </div>
            )}

            <div class="card-content">
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
                <span class="read-more">Read →</span>
            </div>

        </a>
    ))}
</div>
</div>


        <!-- CTA (REUSABLE COMPONENT) -->
        {
            showCTA && (
                <CTA
                    title="Still unsure about navigating Delhi?"
                    description="Get clarity before you step out. No confusion. No overwhelm."
                    buttonText="Get Help"
                    href="/contact"
                />
            )
        }

        <!-- PAGINATION -->
        <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={`/category/${category.toLowerCase()}`}
        />
    </section>
</BaseLayout>

<style>
    :root {
        --accent: rgba(255, 140, 0, 0.12);
        --accent-strong: rgba(255, 140, 0, 0.25);
    }

    /* LAYOUT */
    .category-container {
        padding: 3rem 6vw;
    }

    /* BREADCRUMB */
    .breadcrumb {
        font-size: 0.8rem;
        opacity: 0.6;
        margin-bottom: 1.5rem;
    }

    .breadcrumb a {
        text-decoration: none;
        color: inherit;
    }

    .breadcrumb span {
        margin: 0 6px;
    }

    .breadcrumb .current {
        opacity: 0.9;
    }

    /* HERO */
    .category-hero {
        position: relative;
        padding: 3rem;
        border-radius: 24px;
        margin-bottom: 3rem;
        overflow: hidden;
    }

    .hero-accent {
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, var(--accent), transparent 70%);
        top: -100px;
        right: -100px;
    }

    .category-label {
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 1.2px;
        opacity: 0.6;
    }

    .category-hero h1 {
        font-size: 2.8rem;
        margin: 0.5rem 0;
    }

    .category-desc {
        max-width: 600px;
        opacity: 0.75;
        line-height: 1.6;
    }

    /* GRID */
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
    }

    /* CARD */
    .blog-card {
        position: relative;
        padding: 1.5rem;
        border-radius: 18px;
        transition: 0.3s ease;
        overflow: hidden;

        text-decoration: none;
        color: inherit;
    }

    .blog-card:hover {
        transform: translateY(-6px);
    }

    /* subtle accent */
    .card-accent {
        position: absolute;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, var(--accent), transparent 70%);
        top: -80px;
        right: -80px;
        opacity: 0.6;
    }

    /* CONTENT */
    .card-content {
        position: relative;
        z-index: 1;
    }

    .blog-card h3,
    .blog-card p,
    .blog-card span {
        color: inherit;
        text-decoration: none;
    }

    .card-content h3 {
        font-size: 1.2rem;
        margin-bottom: 0.5rem;
    }

    .card-content p {
        font-size: 0.9rem;
        opacity: 0.7;
        margin-bottom: 1rem;
    }

    .read-more {
        font-size: 0.85rem;
        opacity: 0.6;
    }

    /* HOVER ACCENT */
    .blog-card:hover h3 {
        color: rgba(255, 140, 0, 0.9);
    }
    /* HERO */
    .category-hero {
        position: relative;
        border-radius: 24px;
        margin-bottom: 3rem;
        overflow: hidden;
        min-height: 280px;

        display: flex;
        align-items: flex-end;
        padding: 2.5rem;
    }

    /* IMAGE */
.hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
}

/* TARGET THE ACTUAL IMG GENERATED BY ASTRO */
.hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

    /* GRADIENT (key for readability) */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.65) 0%,
            rgba(0, 0, 0, 0.35) 40%,
            rgba(0, 0, 0, 0.1) 100%
        );
        z-index: 1;
    }

    /* ACCENT GLOW */
    .hero-accent {
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, var(--accent), transparent 70%);
        top: -100px;
        right: -100px;
        z-index: 2;
    }

    /* CONTENT */
    .hero-content {
        position: relative;
        z-index: 3;
        color: white;
    }

    .category-label {
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 1.2px;
        opacity: 0.7;
    }

    .category-hero h1 {
        font-size: 2.8rem;
        margin: 0.5rem 0;
    }

    .category-desc {
        max-width: 600px;
        opacity: 0.85;
        line-height: 1.6;
    }
    .hero-image {
        transition: transform 0.6s ease;
    }

    .category-hero:hover .hero-image {
        transform: scale(1.03);
    }
    .hero-overlay {
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.75),
            rgba(0, 0, 0, 0.4),
            rgba(0, 0, 0, 0.15)
        );
    }
    /* FEATURED BLOG */
    .featured-blog {
        padding: 2.5rem;
        border-radius: 24px;
        margin-bottom: 2rem;

        background: linear-gradient(
            135deg,
            rgba(255, 140, 0, 0.08),
            rgba(255, 255, 255, 0.02)
        );

        border: 1px solid rgba(255, 140, 0, 0.15);
        position: relative;
        overflow: hidden;
    }

    .featured-blog::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            circle at top right,
            rgba(255, 140, 0, 0.2),
            transparent 60%
        );
    }

    .featured-content {
        position: relative;
        z-index: 1;
    }

    .featured-content h2 {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
    }

    .featured-link {
        display: inline-block;
        margin-top: 1rem;
        opacity: 0.8;
    }

    /* PREMIUM CARD HOVER */
    .blog-card {
        transition: all 0.35s ease;
    }

    .blog-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 18px;
        padding: 1px;

        background: linear-gradient(
            135deg,
            rgba(255, 140, 0, 0.25),
            rgba(255, 255, 255, 0.05)
        );

        -webkit-mask:
            linear-gradient(#000 0 0) content-box,
            linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;

        opacity: 0;
        transition: 0.3s;
    }

    .blog-card:hover {
        transform: translateY(-8px) scale(1.01);
        box-shadow:
            0 20px 50px rgba(0, 0, 0, 0.15),
            0 0 30px rgba(255, 140, 0, 0.15);
    }

    .blog-card:hover::before {
        opacity: 1;
    }
    /* WRAPPER */
.blog-grid-wrapper {
    position: relative;
}

/* SUBTLE COLOR BACKGROUND */
.grid-bg {
    position: absolute;
    inset: -40px;
    z-index: 0;

    background: radial-gradient(
        circle at 20% 20%,
        rgba(0, 180, 255, 0.08),
        transparent 40%
    ),
    radial-gradient(
        circle at 80% 80%,
        rgba(0, 255, 150, 0.08),
        transparent 40%
    );
}

/* GRID */
.blog-grid {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
}

/* CARD */
.blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;

    padding: 1rem;
    border-radius: 18px;

    transition: all 0.25s ease;
}

/* IMAGE */
.card-image {
    width: 100%;
    height: 140px;
    border-radius: 12px;
    overflow: hidden;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 0.4s ease;
}

/* HOVER IMAGE */
.blog-card:hover .card-image img {
    transform: scale(1.05);
}

/* CONTENT */
.card-content h3 {
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
}

.card-content p {
    font-size: 0.88rem;
    opacity: 0.7;
}

/* HOVER */
.blog-card:hover {
    transform: translateY(-4px);
}

/* READ MORE */
.read-more {
    font-size: 0.8rem;
    opacity: 0.6;
}
.card-image {
    width: 100%;
    height: 140px;
    border-radius: 12px;
    overflow: hidden;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}
.card-image img {
    filter: saturate(0.9) contrast(0.95);
}
</style>
