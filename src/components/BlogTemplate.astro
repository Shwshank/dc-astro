---
import { Image } from "astro:assets";
import CTA from "./CTA.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import defaultAuthor from "../assets/images/shaw_headshot_2.png";
import instagramLogo from "../assets/images/instagram-logo.png";

const {
    title,
    heroImage,
    breadcrumbs = [],
    category,
    gallery = [],
    nextPost,
    finalThought,
    date,
    author,
    authorImage,
    readTimeInMinutes,
    instagramUrl,
    nextBlog,
} = Astro.props as any;
const safeAuthorImage = authorImage || defaultAuthor;

const colorMap: Record<string, string> = {
    transport: "#AF9F1C", 
    safety: "#EE8E43",    
    culture: "#B9D417",   
    concierge: "#8E44AD", 
    food: "#5CCCFB",      
};

// Helper for dynamic colors
const getStyles = (catName: string | undefined) => {
    const colors: Record<string, string> = {
        transport: "#AF9F1C",
        safety: "#EE8E43",
        culture: "#B9D417",
        concierge: "#8E44AD",
        food: "#5CCCFB",
    };
    const base = colors[catName?.toLowerCase() || ""] || "#808080";
    return `background-color: ${base}1F; color: ${base}; border: 1px solid ${base}33;`;
};

// Pre-calculate styles for the two slots to keep the HTML clean
const style1 = getStyles(nextBlog?.category1);
const style2 = getStyles(nextBlog?.category2);


const baseColor = colorMap[category?.toLowerCase()] || "#808080";

const bgColor = `${baseColor}1F`;
---

<div class="blog">
    <!-- BREADCRUMBS -->
    <div class="breadcrumb-wrapper">
        {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
        <span class="category-tag" style={`background-color: ${bgColor}; color: ${baseColor}; border-color: ${baseColor}33;`} >    
            {category}
        </span>
    </div>

    <!-- HERO -->
    <section class="hero">
        {
            heroImage && (
                <Image
                    src={heroImage}
                    alt={title}
                    class="hero-img"
                    loading="eager"
                    format="webp"
                />
            )
        }
        <div class="hero-card">
            <div class="hero-text">
                <h1>{title}</h1>

                <div class="post-meta">
                    <div class="author">
                        <Image src={safeAuthorImage} alt={author} />
                        <a href="/about" <span> {author} </span> </a>
                    </div>

                    <div class="meta-secondary">
                        <span class="dot">•</span>
                        <span>{readTimeInMinutes} min read</span>
                        <span class="dot">•</span>
                        <span class="last-updated">Last updated {date}</span>
                    </div>

                    {
                        instagramUrl && (
                            <a
                                class="instagram-link"
                                href={instagramUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`View the Instagram post for ${title}`}
                                title="View this story on Instagram"
                            >
                                <Image
                                    src={instagramLogo}
                                    alt=""
                                    class="instagram-icon"
                                    width={17}
                                    height={17}
                                />
                            </a>
                        )
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENT -->

    <slot />
    {
        (finalThought && finalThought.unbiased_opinion) && <div class="final-box">
        <p class="final-title">
            {finalThought.title}
        </p>
        <p class="final-main">{finalThought.unbiased_opinion}</p>
        <p class="final-cta">
            What has been the biggest culture shock for you while exploring the
            city?
        </p>

        <div class="final-action">
            <a target="_blank" href="/contact" class="cta-mini">Tell us</a>
        </div>
    </div>

    }
    

    <!-- DISCOVERY -->
    {(nextBlog && nextBlog.title1) &&<section class="discovery">
        <h3 class="discovery-title">Continue exploring</h3>

        <div class="discovery-grid">
            <!-- CARD 1 -->
            {(nextBlog && nextBlog.title1) && nextBlog && <a href={nextBlog.link1} class="discovery-card">
                <div class="discovery-img">
                    <Image src={nextBlog.image1} alt={nextBlog.title1} />
                </div>

                <div class="discovery-content">
                    <p class="tag">{nextBlog.category1}</p>
                    <h4>{nextBlog.title1}</h4>
                    <p class="desc">
                        {nextBlog.description1}
                    </p>
                </div>
            </a>}

            <!-- CARD 2 -->
            {(nextBlog && nextBlog.title2) && <a href={nextBlog.link2} class="discovery-card">
                <div class="discovery-img">
                    <Image src={nextBlog.image2} alt={nextBlog.title2} />
                </div>

                <div class="discovery-content">
                    <p class="tag">{nextBlog.category2}</p>
                    <h4>{nextBlog.title2}</h4>
                    <p class="desc">
                        {nextBlog.description2}
                    </p>
                </div>
            </a>}
        </div>
    </section>}
</div>

<style>
    /* ========================= */
    /* DISCOVERY SECTION */
    /* ========================= */

    /* Container to push the tag to the right */
.breadcrumb-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 12px;
}

/* The Category Tag UI */


    .discovery {
        margin-top: 32px;
    }

    .discovery-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 14px;
        color: var(--text-primary);
    }

    /* grid */
    .discovery-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    /* card */
    .discovery-card {
        display: block;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;

        background: linear-gradient(
            135deg,
            rgba(59, 130, 246, 0.06),
            rgba(255, 255, 255, 0.5)
        );

        border: 1px solid rgba(59, 130, 246, 0.12);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        transition: all 0.25s ease;
    }

    /* hover */
    .discovery-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    /* image */
    .discovery-img img {
        width: 100%;
        height: 140px;
        object-fit: cover;
    }

    /* content */
    .discovery-content {
        padding: 12px 14px;
    }

    .tag {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: 4px;
    }

    .discovery-content h4 {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .desc {
        font-size: 13px;
        color: var(--text-secondary);
    }

    /* ========================= */
    /* DARK MODE */
    /* ========================= */

    body.dark .discovery-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    body.dark .discovery-card:hover {
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    }

    /* ========================= */
    /* MOBILE */
    /* ========================= */

    @media (max-width: 768px) {
        .discovery-grid {
            grid-template-columns: 1fr;
        }

        .discovery-img img {
            height: 160px;
        }
    }

    /* ========================= */
    /* BLOG CONTAINER (GLASS BASE) */
    /* ========================= */

    .blog {
        max-width: 820px;
        margin: 32px auto;
        padding: 0 20px; /* only horizontal spacing */
    }

    /* ========================= */
    /* HERO */
    /* ========================= */

    .hero {
        padding: 20px 0;
    }

    .hero-img {
        width: 100%;
        height: 360px;
        object-fit: cover;
        border-radius: 18px;
    }

    /* ========================= */
    /* HERO CARD (MAIN FOCUS) */
    /* ========================= */

    .hero-card {
        margin-top: 30px;
        margin-bottom: 30px;
        padding: 22px 24px 28px; /* 👈 added extra bottom padding */

        border-radius: 20px;

        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.9) 0%,
            rgba(90, 148, 255, 0.35) 100%
        );
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        box-shadow:
            0 20px 50px rgba(0, 0, 0, 0.12),
            inset 0 1px 0 rgba(255, 255, 255, 0.6);

        position: relative;
        z-index: 2;
    }

    /* subtle brand glow */
    .hero-card::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 20px;

        background: radial-gradient(
            circle at top left,
            rgba(34, 197, 94, 0.12),
            transparent 60%
        );

        pointer-events: none;
    }

    /* ========================= */
    /* HERO TEXT */
    /* ========================= */

    .hero-text {
        text-align: left;
    }

    .hero h1 {
        font-size: 36px;
        line-height: 1.12;
        letter-spacing: -0.025em;
        font-weight: 650;

        margin-bottom: 10px;
        color: var(--text-primary);
    }

    /* ========================= */
    /* META (EDITORIAL STYLE) */
    /* ========================= */

    .post-meta {
        display: flex;
        align-items: center;
        gap: 12px;

        margin-top: 8px;
        font-size: 13px;
        color: var(--text-secondary);

        flex-wrap: wrap;
    }

    .author {
        display: flex;
        align-items: center;
        gap: 8px;

        font-weight: 500;
        color: var(--text-primary);
    }

    .author img {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        object-fit: cover;
    }

    .meta-secondary {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dot {
        opacity: 0.4;
    }

    .instagram-link {
        display: inline-flex;
        align-items: center;
        margin-left: auto;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        background: transparent;
        text-decoration: none;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .instagram-icon {
        width: 17px;
        height: 17px;
        flex: 0 0 auto;
    }

    .instagram-link:hover {
        transform: translateY(-1px);
        opacity: 0.82;
    }

    .instagram-link:focus-visible {
        outline: 2px solid #8e44ad;
        outline-offset: 2px;
    }

    /* ========================= */
    /* CONTENT (READING SURFACE) */
    /* ========================= */

    .content-body {
        margin-top: 28px;
        padding: 20px 22px;

        border-radius: 16px;

        background: rgba(255, 255, 255, 0.55);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        border: 1px solid rgba(255, 255, 255, 0.45);
    }

    /* spacing */
    .content-body > * + * {
        margin-top: 14px;
    }

    /* headings */
    .content-body h2 {
        font-size: 24px;
        margin-top: 28px;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .content-body h3 {
        font-size: 18px;
        margin-top: 18px;
        margin-bottom: 4px;
    }

    /* text */
    .content-body p {
        margin: 0;
        color: var(--text-secondary);
    }

    /* lists */
    .content-body ul {
        padding-left: 18px;
        margin: 0;
    }

    .content-body li {
        margin-bottom: 6px;
    }

    /* ========================= */
    /* FINAL BOX (GLASS CTA) */
    /* ========================= */

    .final-box {
        margin-top: 36px;
        padding: 20px 22px;

        border-radius: 18px;
        background: radial-gradient(
            circle at bottom right,
            rgba(255, 141, 2, 0.12) 0%,
            rgba(179, 242, 253, 0.61) 60%,
            transparent 100%
        );

        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);

        border: 1px solid rgba(255, 255, 255, 0.5);

        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);

        position: relative;
    }

    /* orange CTA glow */
    .final-box::before {
        content: "";
        position: absolute;
        inset: 0;

        border-radius: 18px;

        background: radial-gradient(
            circle at bottom right,
            rgba(255, 140, 0, 0.12),
            transparent 60%
        );
        pointer-events: none;
    }

    /* text */
    .final-title {
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;

        margin-bottom: 10px;

        color: var(--accent-orange);
    }

    .final-main {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 6px;
    }

    .final-box p {
        color: var(--text-secondary);
    }

    /* CTA */
    .final-action {
        display: flex;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .cta-mini {
        font-size: 13px;
        font-weight: 500;

        padding: 6px 14px;
        border-radius: 999px;

        background: var(--accent-orange);
        color: #fff;

        text-decoration: none;
        transition: 0.2s ease;
    }

    .cta-mini:hover {
        transform: translateY(-1px);
        opacity: 0.9;
    }

    /* ========================= */
    /* MOBILE */
    /* ========================= */

    @media (max-width: 768px) {
        .blog {
            margin: 16px auto;
            padding: 18px;
            border-radius: 18px;
        }

        .hero-img {
            height: 240px;
        }

        .hero-card {
            margin-top: 16px;
            padding: 16px;
        }

        .hero h1 {
            font-size: 26px;
            text-align: left;
        }

        .post-meta {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 32px;
            column-gap: 12px;
            row-gap: 4px;
            align-items: center;
        }

        .author {
            grid-column: 1;
            grid-row: 1;
        }

        .meta-secondary {
            grid-column: 1;
            grid-row: 2;
            font-size: 12px;
            opacity: 0.8;
        }

        .instagram-link {
            position: static;
            grid-column: 2;
            grid-row: 1 / span 2;
            justify-self: end;
            align-self: center;
            margin: 0;
        }

        .content-body {
            padding: 16px;
        }
    }
    body.dark .blog {
        background: transparent;
        border: none;
        box-shadow: none;
        backdrop-filter: none;
    }
    body.dark .hero-card {
        background: linear-gradient(
            135deg,
            rgba(38, 44, 54, 0.45),
            rgba(28, 41, 73, 0.35)
        );

        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);

        box-shadow:
            0 25px 70px rgba(0, 0, 0, 0.65),
            inset 0 1px 0 rgba(255, 255, 255, 0.06);

        position: relative;
    }
    body.dark .hero-card::before {
        background: radial-gradient(
            circle at top left,
            rgba(59, 130, 246, 0.25),
            transparent 60%
        );
    }
    body.dark .content-body {
        background: rgba(30, 30, 30, 0.6);

        border: 1px solid rgba(255, 255, 255, 0.06);

        backdrop-filter: blur(14px);
    }
    body.dark .hero h1 {
        color: #f3f4f6;
    }

    body.dark .content-body p {
        color: rgba(255, 255, 255, 0.75);
    }

    body.dark .post-meta {
        color: rgba(255, 255, 255, 0.6);
    }
    body.dark .final-box {
        background: linear-gradient(
            135deg,
            rgba(30, 30, 30, 0.7),
            rgba(20, 20, 20, 0.6)
        );

        border: 1px solid rgba(255, 255, 255, 0.08);

        backdrop-filter: blur(16px);
    }
    .meta-secondary {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: var(--text-secondary);
    }

    .last-updated {
        font-weight: inherit;
    }

    /* optional subtle highlight */
    .last-updated {
        opacity: 0.9;
    }
    html.dark .meta-secondary {
        color: rgba(255, 255, 255, 0.7);
    }

    html.dark .last-updated {
        color: rgba(255, 255, 255, 0.85);
    }
    .author a {
  text-decoration: none;
  color: inherit;
}

.author a:hover {
  text-decoration: none;
  color: inherit;
}

 .category-tag {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    
    padding: 4px 12px;
    border-radius: 999px; /* Pill shape */
    border: 1px solid; /* Color handled by inline style */
    
    display: inline-flex;
    align-items: center;
    justify-content: center;
    
    /* Clean transition if you ever add hover effects */
    transition: all 0.2s ease;
}


/* Mobile-only tweak to shift the tag up */
@media (max-width: 480px) {
    .category-tag {
        margin-top: -50px !important;
    }
}


</style>
