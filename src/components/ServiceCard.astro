---
import { Image } from "astro:assets";

const {
  image,
  alt,
  title,
  points = [],
  meta = "",
  featured = false,
  href = "#"
} = Astro.props;
---

<a href={href} class={`service-card ${featured ? "featured" : ""}`}>

  <svg class="card-deco" viewBox="0 0 100 100">
    <path d="M0 40 Q40 0 80 20"></path>
  </svg>

  <div class="service-image">
    <Image
      src={image}
      alt={alt}
      width={800}
      height={500}
      loading="lazy"
    />
  </div>

  <h3>{title}</h3>

  <ul>
    {points.map((item: any) => (
      <li>{item}</li>
    ))}
  </ul>

  {meta && <p class="service-meta">{meta}</p>}

</a>


<style>

/* service card */

.service-card{
position:relative;
background:var(--bg-surface);
padding:20px;
border-radius:var(--radius-md);

box-shadow:
0 14px 36px rgba(0,0,0,.08),
inset 0 1px 0 rgba(255,255,255,.4);

transition:.25s;
display:block;
text-decoration:none;
color:inherit;
cursor:pointer;
}

.service-card:hover{
transform:translateY(-6px);
box-shadow:0 22px 60px rgba(0,0,0,.15);
}

/* decoration */

.card-deco{
position:absolute;
top:12px;
right:12px;
width:70px;

stroke:var(--accent-blue);
stroke-width:1;
fill:none;
opacity:.25;
}

/* image */

.service-image{
width:100%;
aspect-ratio:16/10;
border-radius:14px;
overflow:hidden;
margin-bottom:14px;
position:relative;
}

.service-image img{
width:100%;
height:100%;
object-fit:cover;
display:block;
transition:transform .35s ease;
}

.service-card:hover img{
transform:scale(1.05);
}

/* overlay */

.service-image::after{
content:"";
position:absolute;
inset:0;

background:linear-gradient(
to bottom,
rgba(0,0,0,0) 60%,
rgba(0,0,0,.18)
);
}

/* list */

.service-card ul{
margin:10px 0 12px;
padding-left:18px;
font-size:14px;
color:var(--text-secondary);
}

/* meta */

.service-meta{
font-size:13px;
color:var(--text-muted);
}

/* featured */

.featured{
border:1px solid rgba(92,204,251,.35);
box-shadow:0 18px 50px rgba(92,204,251,.18);
}

</style>