---
const { items = [] } = Astro.props as any;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item: any, index: number) => (
      <li>
        {item.href && index !== items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="current">{item.label}</span>
        )}

        {index < items.length - 1 && (
          <span class="sep">›</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
.breadcrumbs {
  display: inline-flex;
  align-items: center;

  padding: 8px 14px;
  border-radius: 999px;

  background: var(--bg-soft);
  border: 1px solid var(--border);

  font-size: 14px;
  color: var(--text-soft);

  margin-bottom: 2px;
}

/* layout */
.breadcrumbs ol {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;

  padding: 0;
  margin: 0;
  list-style: none;
}

/* each item */
.breadcrumbs li {
  display: flex;
  align-items: center;
}

/* links */
.breadcrumbs a,
.breadcrumbs a:visited {
  text-decoration: none;
  color: var(--text-soft);

  padding: 2px 6px;
  border-radius: 6px;

  transition: 0.2s ease;
}

.breadcrumbs a:hover,
.breadcrumbs a:active {
  background: var(--bg-soft);
  color: var(--text);
}
/* current page */
.current {
  color: var(--text);
  font-weight: 500;
  padding: 4px 8px;
}

/* separator */
.sep {
  margin: 0 4px;
  color: var(--text-soft);
  opacity: 0.5;
  font-size: 12px;
}
</style>