<style>
    /* HERO */

    .service-hero-section {
        padding-top: 40px;
        padding-bottom: 40px;
        position: relative;
        overflow: hidden;
    }

    .hero-container {
        position: relative;
    }

    /* warm accent glow */

    .service-accent {
        position: absolute;
        top: -120px;
        right: -120px;
        width: 420px;
        height: 420px;

        background: radial-gradient(
            circle at center,
            rgba(238, 142, 67, 0.18),
            transparent 65%
        );

        filter: blur(10px);
        pointer-events: none;
    }

    /* watermark */

    .service-watermark {
        position: absolute;
        right: 40px;
        top: 20px;
        width: 180px;
        opacity: 0.35;
        pointer-events: none;
    }

    /* HERO TEXT HIERARCHY */

    .service-title {
        font-size: 44px;
        line-height: 1.2;
        margin-bottom: 10px;
    }

    .service-subtitle {
        font-size: 18px;
        color: var(--text-secondary);
        margin-bottom: 14px;
    }

    .service-description {
        font-size: 16px;
        color: var(--text-secondary);
        max-width: 520px;
        margin-bottom: 12px;
    }

    /* bullets */

    .service-bullets {
        margin: 10px 0 18px 18px;
    }

    .service-bullets li {
        margin-bottom: 6px;
    }

    /* note */

    .service-note {
        margin-top: 8px;
        color: var(--text-muted);
        font-size: 14px;
    }

    /* section header */

    .section-header {
        margin-bottom: 18px;
    }

    .section-line {
        width: 60px;
        height: 2px;
        background: var(--accent-blue);
        margin-top: 6px;
    }

    /* about */

    .about-text {
        max-width: 680px;
        color: var(--text-secondary);
    }

    /* spacing */

    .service-about-section {
        padding-top: 40px;
        padding-bottom: 40px;
    }

    .service-includes-section {
        padding-top: 40px;
        padding-bottom: 40px;
    }

    /* CTA */

    .cta-block {
        text-align: center;
        max-width: 520px;
        margin: auto;
    }
    .cta-wide{
max-width:1100px;
margin:auto;
padding:0 20px;
}
    .service-explore-section {
        padding-top:60px;
padding-bottom:30px;
    }
</style>
