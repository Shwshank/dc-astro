---
import "../styles/style.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SuccessModal from "../components/SuccessModal.astro";
import heroImage from "../assets/images/delhi_hero.webp";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>{title}</title>

        <meta
            name="description"
            content="Personal help for travellers and expats arriving in Delhi. Orientation sessions, safe exploration and settling-in support across Delhi NCR."
        />

        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://delhiconcierge.in/" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <link as="image" href={heroImage.src} />

        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
            rel="stylesheet"
        />

        <!-- Firebase -->
        <script
            src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"
            is:inline></script>
        <script
            src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"
            is:inline></script>

        <script is:inline>
            const firebaseConfig = {
                apiKey: "AIzaSyARgNCysirTHx2XBbUhSBjzllMQPApZA6U",
                authDomain: "delhi-concierge.firebaseapp.com",
                projectId: "delhi-concierge",
                storageBucket: "delhi-concierge.firebasestorage.app",
                messagingSenderId: "721833285362",
                appId: "1:721833285362:web:34d5fb881bf5738cf8e26b",
                measurementId: "G-3Y3QV7PBBN",
            };
            firebase.initializeApp(firebaseConfig);
        </script>

        <!-- Google Analytics -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-3Y3QV7PBBN"
        ></script>

        <script is:inline>
            const isLocal =
                location.hostname === "localhost" ||
                location.hostname === "127.0.0.1" ||
                location.hostname === "0.0.0.0" ||
                location.hostname.endsWith(".local") ||
                location.hostname.startsWith("192.168.");

            if (!isLocal) {
                window.dataLayer = window.dataLayer || [];
                function gtag() {
                    dataLayer.push(arguments);
                }
                gtag("js", new Date());
                gtag("config", "G-3Y3QV7PBBN");
            } else {
                console.log("GA4 tracking disabled for local development.");
            }
        </script>
    </head>

    <body>
        <Navbar />

        <div class="app-shell">
            <div class="page">
                <slot />

                <Footer />
            </div>
        </div>

        <!-- <a href="https://wa.me/918929748506" class="whatsapp" target="_blank">
            WhatsApp
        </a> -->

        <SuccessModal />

        <script type="module" src="/scripts/script.js"></script>
        <script>
            window.addEventListener("pageshow", () => {
                document.body.classList.remove("page-leave");
            });

            // Go on top button
            window.addEventListener("load", () => {
                if ((window as any).__scrollTopInitialized) return;
                (window as any).__scrollTopInitialized = true;
               

                const btn = document.querySelector(".scroll-top") as HTMLElement | null;
                if (!btn) return;
                function toggleVisibility() {
                    if (window.scrollY > 200) {
                        btn && btn.classList.add("visible");
                    } else {
                        btn && btn.classList.remove("visible");
                    }
                }

                function scrollToTop() {
                    window.scrollTo({
                        top: 0,
                        behavior: "smooth",
                    });
                }

                window.addEventListener("scroll", toggleVisibility);
                btn.addEventListener("click", scrollToTop);

                toggleVisibility(); // run once
            });
        </script>

        <button class="btn scroll-top" aria-label="Go to top"> ▲ </button>
    </body>
</html>
