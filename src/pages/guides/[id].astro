---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTemplate from "../../components/BlogTemplate.astro";
import CTA from "../../components/CTA.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/*.{jpeg,jpg,png,gif,webp}",
);

export async function getStaticPaths() {
    const guides = await getCollection("guides");
    return guides.map((entry) => ({
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const heroImagePath = Object.entries(images).find(([path]) => {
    const fileName = path.split("/").pop()?.split(".")[0].toLowerCase();
    return fileName === entry.data.heroImage?.toLowerCase();
});

let heroImageResolved;

if (!heroImagePath) {
    console.warn(`⚠️ Image "${entry.data.heroImage}" not found`);

    const fallback = Object.entries(images).find(([path]) =>
        path.includes("delhi_hero"),
    );

    heroImageResolved = fallback ? (await fallback[1]()).default : undefined;
} else {
    heroImageResolved = (await heroImagePath[1]()).default;
}
const imageMap = images;
---

<BaseLayout title={entry.data.title}>
    <BlogTemplate
        title={entry.data.title}
        heroImage={heroImageResolved}
        gallery={await Promise.all(
            (entry.data.gallery ?? []).map(async (img) => {
                const match = Object.entries(images).find(([path]) => {
                    const fileName = path
                        .split("/")
                        .pop()
                        ?.split(".")[0]
                        .toLowerCase();
                    return fileName === img.toLowerCase();
                });

                return match ? (await match[1]()).default : null;
            }),
        ).then((arr) => arr.filter(Boolean))}
        breadcrumbs={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: entry.data.title },
        ]}
        date={entry.data.pubDate.toDateString()}
        author={entry.data.author}
        readTimeInMinutes={5}
        cta={{
            title: "Move smarter, not harder.",
            description:
                "Delhi Concierge helps you navigate pricing, movement, and decisions with clarity.",
            buttonText: "Explore Delhi Guides",
            link: "/guides",
        }}
        finalThought={{
            title: "Final Thought",
            unbiased_opinion:
                "In Delhi, prices aren’t confusing — they’re conversational.",
        }}
    >
        <!-- 🔥 THIS IS THE MAGIC -->
        <article class="blog-content">
            <Content />
        </article>
    </BlogTemplate>

    <CTA />
</BaseLayout>
