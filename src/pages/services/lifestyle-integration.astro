---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceTemplate from "../../components/ServiceTemplate.astro";
import heroImg from "../../assets/images/driver_2.png";
---

<BaseLayout title="Lifestyle Integration">

<ServiceTemplate
  title="Lifestyle Integration"
  subtitle="Settle into Delhi with confidence"
  heroImage={heroImg}
  shortDescription="A concierge service designed to help travellers and expats integrate into daily life in Delhi through activities, routines and local experiences."
  bullets={[
    "Guidance on everyday life in Delhi",
    "Connecting with cultural activities",
    "Learning to navigate public transportation",
    "Finding local communities and experiences"
  ]}
  aboutText="Living in Delhi becomes much easier when you understand how daily routines work. This service introduces travellers and expats to the lifestyle patterns of the city — from transportation habits to cultural activities and social spaces."
  ctaText="Plan Lifestyle Integration"
  ctaLink="/contact"
>

<!-- LIFE IN DELHI -->

<section class="section lifestyle-pillars">
<div class="container">

<h2>Understanding everyday life in Delhi</h2>

<div class="pillar-grid">

<div class="pillar">
<h3>Movement in the City</h3>
<p>
Learn how residents move around the city using metro,
ride apps and neighbourhood transport options.
</p>
</div>

<div class="pillar">
<h3>Local Communities</h3>
<p>
Discover cafés, community spaces and neighbourhood
spots where people gather and interact.
</p>
</div>

<div class="pillar">
<h3>City Rhythm</h3>
<p>
Understand the daily rhythm of markets, work hours
and social life across different districts.
</p>
</div>

</div>

</div>
</section>



<!-- ACTIVITIES -->

<section class="section lifestyle-activities">
<div class="container">

<h2>Activities you can integrate into your routine</h2>

<div class="activity-grid">

<div class="activity">
<h4>Yoga & Wellness</h4>
<p>
Join yoga studios, wellness spaces and meditation
centres across Delhi.
</p>
</div>

<div class="activity">
<h4>Dance & Cultural Arts</h4>
<p>
Discover dance studios and cultural classes that
introduce you to Indian art traditions.
</p>
</div>

<div class="activity">
<h4>Creative Communities</h4>
<p>
Explore photography walks, art spaces and creative
events happening across the city.
</p>
</div>

<div class="activity">
<h4>Food & Social Spaces</h4>
<p>
Find cafés, restaurants and neighbourhood
spaces that locals enjoy regularly.
</p>
</div>

</div>

</div>
</section>



<!-- PRACTICAL LIVING -->

<section class="section daily-living">
<div class="container">

<h2>Practical everyday guidance</h2>

<div class="living-list">

<div class="living-item">
<span class="living-icon">🚇</span>
<p>Using the Delhi Metro and public transport comfortably</p>
</div>

<div class="living-item">
<span class="living-icon">📱</span>
<p>Essential apps used by residents for transport and services</p>
</div>

<div class="living-item">
<span class="living-icon">🛍</span>
<p>Where locals shop for everyday needs</p>
</div>

<div class="living-item">
<span class="living-icon">☕</span>
<p>Neighbourhood cafés and social spaces</p>
</div>

</div>

</div>
</section>

</ServiceTemplate>

</BaseLayout>



<style>

/* PILLARS */

.pillar-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:24px;
}

.pillar{
padding:18px;
border-radius:var(--radius-md);
background:var(--bg-surface);
box-shadow:
0 10px 24px rgba(0,0,0,.05),
inset 0 1px 0 rgba(255,255,255,.4);
}



/* ACTIVITIES */

.activity-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:24px;
}

.activity{
padding:16px;
border-left:3px solid var(--accent-blue);
}



/* DAILY LIVING */

.living-list{
display:flex;
flex-direction:column;
gap:14px;
margin-top:20px;
}

.living-item{
display:flex;
gap:12px;
align-items:center;
padding:12px 16px;
border-radius:var(--radius-sm);
background:rgba(92,204,251,.12);
}

.living-icon{
font-size:18px;
}

</style>