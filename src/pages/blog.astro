---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import { getCollection } from "astro:content";

const guides = (await getCollection("blog"))
    .filter((g) => !g.data.draft)
    .sort((a: any, b: any) => b.data.pubDate - a.data.pubDate);

const categories = [
    {
        key: "transport",
        title: "Delhi Transport Guide",
        description:
            "Practical knowledge for navigating everyday life in Delhi — transportation, useful apps, payments, neighbourhoods, and avoiding common mistakes.",
        meta: "Transport • SIM cards • Local apps",
        icon: "circle",
    },
    {
        key: "safety",
        title: "Safety & Scam Awareness",
        description:
            "Learn how common scams work, where travelers get misled, and how to navigate situations confidently.",
        meta: "Taxi scams • Fake guides • Tourist traps",
        icon: "diamond",
    },
    {
        key: "culture",
        title: "Food & Cultural Decoding",
        description:
            "Understand food, etiquette, and cultural signals that visitors often misunderstand.",
        meta: "Etiquette • Food • Cultural habits",
        icon: "double-circle",
    },
    {
        key: "concierge",
        title: "Concierge Insights",
        description:
            "Behind-the-scenes insights from working as a concierge in Delhi.",
        meta: "Real experiences • Travel insights • Local strategies",
        icon: "curve",
    },
];

const guidesByCategory = categories.reduce(
    (acc, cat) => {
        acc[cat.key] = guides.filter((g) => g.data.category === cat.key);
        return acc;
    },
    {} as Record<string, typeof guides>,
);

const uniqueCategories = [
    "all",
    ...Array.from(new Set(guides.map((g) => g.data.category))),
];
---

<BaseLayout title="Blog | Delhi Concierge">
    <!-- Hero -->

    <!-- BLOG CATEGORIES -->

    <section class="blog-feed">
        <div class="feed-wrapper">
            <div class="feed-header">
                <h2 class="feed-title">All Blogs ({guides.length})</h2>

                <select id="categoryFilter" class="category-dropdown">
                    {
                        uniqueCategories.map((cat: any) => (
                            <option value={cat}>
                                {cat === "all"
                                    ? "All"
                                    : cat.charAt(0).toUpperCase() +
                                      cat.slice(1)}
                            </option>
                        ))
                    }
                </select>
            </div>

            <!-- LIST -->
            <div class="feed-list" id="guideList">
                {
                    guides.map((guide) => (
                        <a
                            href={`/blog/${guide.id}`}
                            class="feed-item"
                            data-category={guide.data.category}
                        >
                            <div class="feed-left">
                                <h3>{guide.data.title}</h3>
                                <p>
    {guide.data.description}
    {guide.data.readingTime && (
        <>
            {" "}
            • <span style="color:var(--accent-blue)" > <b> {guide.data.readingTime} min </b> </span>
        </>
    )}
</p>
                                
                            </div>

                            <div class="feed-right">
                                <span>
                                    {guide.data.category
                                        .charAt(0)
                                        .toUpperCase() +
                                        guide.data.category.slice(1)}
                                </span>

                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <h2 class="blog-title">Browse by Topic</h2>

            <div class="blog-grid">
                {
                    categories.map((cat) => (
                        <a href={`#${cat.key}`} class={`blog-card ${cat.key}`}>
                            <svg class="card-art" viewBox="0 0 200 200">
                                {cat.icon === "circle" && (
                                    <circle cx="100" cy="100" r="80" />
                                )}
                                {cat.icon === "diamond" && (
                                    <path d="M20 100 L100 20 L180 100 L100 180 Z" />
                                )}
                                {cat.icon === "double-circle" && (
                                    <>
                                        <circle cx="60" cy="100" r="30" />
                                        <circle cx="140" cy="100" r="30" />
                                    </>
                                )}
                                {cat.icon === "curve" && (
                                    <path d="M40 160 Q100 40 160 160" />
                                )}
                            </svg>

                            <h3>{cat.title}</h3>
                            <p>{cat.description}</p>

                            <span class="meta">{cat.meta}</span>
                            <span class="read">
                                {guidesByCategory[cat.key].length} Blogs →
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const filter = document.getElementById(
                "categoryFilter",
            ) as HTMLSelectElement | null;
            const items = document.querySelectorAll<HTMLElement>(
                "#guideList .feed-item",
            );
            const title = document.querySelector(
                ".feed-title",
            ) as HTMLElement | null;

            if (!filter || !title) return;

            const safeFilter = filter;
            const safeTitle = title;

            function updateList() {
                const value = safeFilter.value;
                let visibleCount = 0;

                items.forEach((item) => {
                    const category = item.dataset.category;

                    if (value === "all" || category === value) {
                        item.style.display = "flex";
                        visibleCount++;
                    } else {
                        item.style.display = "none";
                    }
                });

                safeTitle.innerText =
                    value === "all"
                        ? `All Blogs (${visibleCount})`
                        : `Blog ${value.charAt(0).toUpperCase() + value.slice(1)} (${visibleCount})`;
            }

            safeFilter.addEventListener("change", updateList);
            updateList();
        });
    </script>
    <CTA />
    <style>
        /* ================= ROOT ================= */

        :root {
            --glass-bg: rgba(255, 255, 255, 0.6); /* ⬅️ FIXED */
            --glass-border: rgba(0, 0, 0, 0.06);
            --glass-soft: rgba(255, 255, 255, 0.5); /* ⬅️ FIXED */
            --glass-hover: rgba(255, 255, 255, 0.7);
        }

        /* ================= BLOG FEED ================= */

        .blog-feed {
            padding-top: 30px;
            margin-bottom: 70px;
        }

        /* ================= FEED WRAPPER ================= */

        .feed-wrapper {
            position: relative;
            isolation: isolate; /* 🔥 fixes glow bleed */

            max-width: 820px;
            margin: 0 auto;

            padding: 28px 28px 18px;
            border-radius: 24px;

            background: var(--glass-bg);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border: 1px solid var(--glass-border);

            box-shadow:
                0 30px 60px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);

            overflow: hidden;
        }

        /* 🔥 SAFE glow */
        .feed-wrapper::before {
            content: "";
            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.2),
                    transparent 60%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(255, 140, 64, 0.2),
                    transparent 60%
                );

            z-index: -1;
        }

        /* ================= HEADER ================= */

        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .feed-title {
            font-size: 24px;
            font-weight: 500;
            color: var(--text-primary);
        }

        /* ================= DROPDOWN ================= */

        .category-dropdown {
            padding: 8px 14px;
            border-radius: 12px;

            border: 1px solid var(--glass-border);
            background: var(--glass-soft);

            color: var(--text-primary);
            font-size: 14px;

            cursor: pointer;
        }

        /* ================= LIST ================= */

        .feed-list {
            display: flex;
            flex-direction: column;
            gap: 10px;

            max-height: 520px; /* slightly more space */
            overflow-y: auto;

            padding-right: 6px;
            padding-bottom: 4px;
        }

        /* SCROLLBAR */

        .feed-list::-webkit-scrollbar {
            width: 6px;
        }

        .feed-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.18);
            border-radius: 10px;
        }

        /* ================= ITEM ================= */

        .feed-item {
            display: flex;
            justify-content: space-between;
            align-items: stretch;

            padding: 14px 14px;
            border-radius: 14px;

            text-decoration: none;
            transition: all 0.2s ease;
        }

        /* EVEN */
        .feed-item:nth-child(even) {
            background: rgba(255, 255, 255, 0.01);
        }

        /* ODD */
        .feed-item:nth-child(odd) {
            background: rgba(255, 255, 255, 0.75);
        }

        .feed-item:hover {
            transform: translateX(4px);

            background: rgba(255, 255, 255, 0.5);

            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
        }

        /* ================= LEFT ================= */

        .feed-left {
            display: flex;
            flex-direction: column;
        }

        .feed-left h3 {
            font-size: 18px;
            margin-bottom: 4px;
            font-weight: 500;
            color: var(--text-primary);
        }

        .feed-left p {
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* ================= RIGHT TAG ================= */

        .feed-right {
            display: flex;
            align-items: center;

            font-size: 10px;
            letter-spacing: 1.4px;
            text-transform: uppercase;

            padding: 6px 12px;
            border-radius: 999px;

            background: rgba(0, 0, 0, 0.04); /* FIXED */
            border: 1px solid rgba(0, 0, 0, 0.08);

            color: rgba(0, 0, 0, 0.6);
        }

        body.dark .feed-item:nth-child(even) {
            background: rgba(255, 255, 255, 0.04);
        }

        body.dark .feed-item:nth-child(odd) {
            background: rgba(255, 255, 255, 0.07);
        }

        body.dark .feed-item:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        body.dark .feed-right {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: rgba(255, 255, 255, 0.7);
        }

        .feed-list::-webkit-scrollbar {
            width: 6px;
        }

        .feed-list::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 10px;
        }

        body.dark .feed-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
        }

        /* ================= BLOG GRID ================= */

        .blog-title {
            margin-bottom: 28px;
            font-size: 26px;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 26px;
        }

        /* ================= BLOG CARD ================= */

        .blog-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .blog-card {
            background: var(--bg-surface);
            padding: 26px;
            border-radius: var(--radius-md);

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.06),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);

            transition: 0.25s;
        }

        .blog-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 55px rgba(0, 0, 0, 0.12);
        }

        .blog-card h3 {
            margin-bottom: 10px;
            font-size: 20px;
        }

        .blog-card p {
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .blog-meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .blog-link {
            text-decoration: none;
            font-weight: 500;
            color: var(--accent-blue);
        }

        .blog-link:hover {
            text-decoration: underline;
        }

        /* RESPONSIVE */

        @media (min-width: 780px) {
            .blog-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        /* ================= BLOG PREMIUM GRID ================= */

        .blog-title {
            margin-bottom: 28px;
            font-size: 26px;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 26px;
        }

        /* ================= GLASS CARD ================= */

        .blog-card {
            position: relative;
            display: block;

            padding: 30px;
            border-radius: 24px;

            text-decoration: none;
            color: var(--text-primary);

            background: linear-gradient(
                160deg,
                rgba(255, 255, 255, 0.08),
                rgba(255, 255, 255, 0.02)
            );

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255, 255, 255, 0.08);

            box-shadow:
                0 30px 60px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.06);

            transition: 0.35s var(--ease);

            overflow: hidden;
        }

        /* glow layer */

        .blog-card::before {
            content: "";
            position: absolute;
            inset: -1px;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.25),
                    transparent 50%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(238, 142, 67, 0.2),
                    transparent 55%
                );

            opacity: 0.35;
            filter: blur(30px);

            z-index: -1;
        }

        /* hover */

        .blog-card:hover {
            transform: translateY(-10px);

            box-shadow:
                0 50px 100px rgba(0, 0, 0, 0.55),
                inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }

        /* svg design */

        .card-art {
            position: absolute;
            top: -20px;
            right: -10px;

            width: 160px;
            height: 160px;

            stroke: rgba(255, 255, 255, 0.08);
            stroke-width: 2;
            fill: none;

            opacity: 0.35;
        }

        /* text */

        .blog-card h3 {
            margin-bottom: 10px;
            font-size: 20px;
        }

        .blog-card p {
            color: var(--text-secondary);
            margin-bottom: 14px;
        }

        .meta {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .read {
            color: var(--accent-blue);
            font-weight: 500;
        }

        /* ================= RESPONSIVE ================= */

        @media (min-width: 780px) {
            .blog-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (min-width: 1100px) {
            .blog-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        /* ================= BLOG CARDS LIGHT MODE FIX ================= */

        body:not(.dark) .blog-card {
            background: linear-gradient(
                160deg,
                rgba(255, 255, 255, 0.85),
                rgba(255, 255, 255, 0.35)
            );

            border: 1px solid rgba(0, 0, 0, 0.06);

            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

        /* ambient glow layer */

        body:not(.dark) .blog-card::before {
            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.25),
                    transparent 55%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(238, 142, 67, 0.25),
                    transparent 60%
                );

            opacity: 0.45;
        }

        /* svg art visibility */

        body:not(.dark) .card-art {
            stroke: rgba(0, 0, 0, 0.12);
            opacity: 0.35;
        }

        /* hover depth */

        body:not(.dark) .blog-card:hover {
            box-shadow:
                0 35px 70px rgba(0, 0, 0, 0.15),
                inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }
        .card-art {
            stroke-width: 2;
            fill: none;
        }
    </style>
</BaseLayout>
