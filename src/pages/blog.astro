---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blogs = (await getCollection("blog"))
    .filter((g) => !g.data.draft)
    .sort((a: any, b: any) => b.data.pubDate - a.data.pubDate);

    const colorMap: Record<string, string> = {
        transport: "#AF9F1C", // Brown
        safety: "#EE8E43", // Delhi Orange
        culture: "#B9D417", // Neon Green
        concierge: "#8E44AD", // Baigani / Purple
        food: "#5CCCFB", // Electric Blue
};

const uniqueCategories = [
    "all",
    ...Array.from(new Set(blogs.map((g) => g.data.category))),
];
---

<BaseLayout title="Blog | Delhi Concierge">
    <section class="blog-feed">
        <div class="feed-wrapper">
            <div class="feed-header">
                <h2 class="feed-title">All Blogs ({blogs.length})</h2>

                <!-- UI Custom Dropdown -->
                <div class="filter-container">
                    <div id="filterTrigger" class="filter-trigger">
                        <span id="triggerText">All Blogs</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="m6 9 6 6 6-6"></path></svg
                        >
                    </div>

                    <div id="filterMenu" class="filter-menu">
                        {
                            uniqueCategories.map((cat: any) => {
                                const catKey = cat.toLowerCase().trim();
                                const themeColor =
                                    colorMap[catKey] || "#7a7a7a";
                                return (
                                    <div
                                        class="filter-option"
                                        data-value={cat}
                                        style={`--opt-color: ${themeColor}`}
                                    >
                                        <span class="filter-dot" />
                                        {cat === "all"
                                            ? "All Blogs"
                                            : cat.charAt(0).toUpperCase() +
                                              cat.slice(1)}
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>

                <!-- Keep this hidden input to stay compatible with your existing filtering script -->
                <input type="hidden" id="categoryFilter" value="all" />
            </div>

            <!-- LIST -->
            <div class="feed-list" id="bloglist">
                {
                    blogs.map((blog) => {
                        // 1. Normalize the string (lowercase and trim whitespace)
                        const rawCategory = blog.data.category || "";
                        const categoryKey = rawCategory.toLowerCase().trim();

                        // 2. Map to color, or use a default if it's a new category
                        const themeColor = colorMap[categoryKey] || "#7a7a7a";

                        return (
                            <a
                                href={`/blog/${blog.id}`}
                                class="feed-item"
                                data-category={blog.data.category}
                                style={`--item-color: ${themeColor}; --item-glow: ${themeColor}44;`}
                            >
                                <div class="feed-left">
                                    <div class="title-row">
                                        <span class="dot" />
                                        <h3>{blog.data.title}</h3>
                                    </div>
                                    <p>
                                        {blog.data.description}
                                        {blog.data.readingTime && (
                                            <span class="read-tag">
                                                •{" "}
                                                <b>
                                                    {blog.data.readingTime} min
                                                </b>
                                            </span>
                                        )}
                                    </p>
                                </div>

                                <div class="feed-right">
                                    <span>
                                        {blog.data.category
                                            .charAt(0)
                                            .toUpperCase() +
                                            blog.data.category.slice(1)}
                                    </span>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        // Elements for Filtering
        const filterInput = document.getElementById("categoryFilter") as HTMLInputElement | null;
        const items = document.querySelectorAll<HTMLElement>("#bloglist .feed-item");
        const title = document.querySelector(".feed-title") as HTMLElement | null;

        // Elements for Custom UI Dropdown
        const trigger = document.getElementById("filterTrigger");
        const menu = document.getElementById("filterMenu");
        const triggerText = document.getElementById("triggerText");
        const options = document.querySelectorAll(".filter-option");

        if (!filterInput || !title || !trigger || !menu) return;

        // 1. Toggle Menu Visibility
        trigger.addEventListener("click", (e) => {
            e.stopPropagation();
            menu.classList.toggle("is-active");
        });

        // 2. Close menu when clicking outside
        document.addEventListener("click", () => {
            menu.classList.remove("is-active");
        });

        // 3. Handle Option Selection
        options.forEach(option => {
            option.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLElement;
                const value = target.getAttribute("data-value") || "all";
                const displayLabel = target.innerText.trim();

                // Update UI
                if (triggerText) triggerText.innerText = displayLabel;
                filterInput.value = value;
                
                // Close menu
                menu.classList.remove("is-active");

                // Run the filtering logic
                updateList();
            });
        });

        // 4. Filtering Logic
        function updateList() {
            const value = filterInput ? filterInput.value : "all";
            let visibleCount = 0;

            items.forEach((item) => {
                const category = item.dataset.category;

                // Case-insensitive comparison is safer
                if (value === "all" || category?.toLowerCase() === value.toLowerCase()) {
                    item.style.display = "flex";
                    visibleCount++;
                } else {
                    item.style.display = "none";
                }
            });

            title && (title.innerText =
                value === "all"
                    ? `All Blogs (${visibleCount})`
                    : `Blog ${value.charAt(0).toUpperCase() + value.slice(1)} (${visibleCount})`);
        }

        // Initialize
        updateList();
    });
</script>
    <style>
        /* ================= FEED SECTION (FIXED & UPGRADED) ================= */

        .blog-feed {
            padding-top: 30px;
            margin-bottom: 70px;
        }

        .feed-wrapper {
            position: relative;
            isolation: isolate;
            max-width: 860px;
            margin: 0 auto;
            padding: 32px; /* Uniform padding */

            border-radius: 30px; /* Slightly smoother radius */

            background: linear-gradient(
                160deg,
                rgba(255, 255, 255, 0.72),
                rgba(255, 255, 255, 0.25)
            );

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);

            box-shadow:
                0 35px 70px rgba(0, 0, 0, 0.32),
                inset 0 1px 0 rgba(255, 255, 255, 0.12);

            /* FIX: Removed overflow:auto from here to prevent clipping */
        }

        .feed-wrapper::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.18),
                    transparent 60%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(255, 140, 64, 0.18),
                    transparent 60%
                );
            z-index: -1;
            border-radius: inherit;
        }

        /* ================= HEADER ================= */

        /* ================= FILTER DROPDOWN ================= */

        .filter-container {
            position: relative;
            width: 180px;
            z-index: 100;
        }

        .filter-trigger {
            padding: 10px 16px;
            border-radius: 14px;
            border: 1px solid var(--glass-border);
            background: var(--glass-soft);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            transition: all 0.3s ease;
        }

        .filter-trigger:hover {
            background: rgba(255, 255, 255, 0.85);
            border-color: rgba(255, 255, 255, 0.5);
        }

        .filter-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 200px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(20px);
            border-radius: 18px;
            border: 1px solid var(--glass-border);
            padding: 8px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            
            /* Hidden by default */
            display: none; 
            flex-direction: column;
            gap: 4px;
        }

        .filter-menu.is-active {
            display: flex;
            animation: filterFade 0.2s ease-out;
        }

        .filter-option {
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--opt-color); /* Applied via style attribute in HTML */
        }

        .filter-option:hover {
            background: color-mix(in srgb, var(--opt-color), transparent 92%);
            transform: translateX(4px);
        }

        .filter-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--opt-color);
            box-shadow: 0 0 8px var(--opt-color);
        }

        @keyframes filterFade {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Dark Mode Support */
        body.dark .filter-menu {
            background: rgba(22, 26, 32, 0.95);
            border-color: rgba(255, 255, 255, 0.1);
        }
        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }
        .feed-title {
            font-size: 24px;
            font-weight: 500;
            color: var(--text-primary);
        }

        .category-dropdown {
            padding: 10px 16px;
            border-radius: 14px;
            border: 1px solid var(--glass-border);
            background: var(--glass-soft);
            backdrop-filter: blur(10px);
            color: var(--text-primary);
            font-size: 14px;
            cursor: pointer;
            transition: 0.2s ease;
        }

        /* ================= LIST (THE SCROLL CONTAINER) ================= */

        .feed-list {
            display: flex;
            flex-direction: column;
            gap: 16px;

            /* FIX: Move scroll logic here */
            max-height: 680px;
            overflow-y: auto;
            overflow-x: visible; /* Allow hover expansion to breathe */

            /* FIX: Added padding so the "lift" on hover doesn't hit the scroll wall */
            padding: 12px 10px 20px 4px;
            margin-right: -10px; /* Offset padding to keep alignment */
        }

        /* Modern scrollbar for the list */
        .feed-list::-webkit-scrollbar {
            width: 5px;
        }
        .feed-list::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        body.dark .feed-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
        }

        /* ================= ITEM (PREMIUM GLASS) ================= */

        .feed-item {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 32px;
            border-radius: 20px;
            text-decoration: none;

            /* Clean Glass Base */
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);

            /* Use the category color for a subtle left accent */
            border: 1px solid rgba(255, 255, 255, 0.5);
            /* border-left: 2px solid var(--item-color); */

            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
            transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
            z-index: 1;
        }

        .feed-item:hover {
            /* FIX: Adjusted transform to be more stable */
            transform: translateY(-4px) scale(1.015);
            z-index: 10; /* Ensures it stays on top of neighbors while scaling */

            background: rgba(255, 255, 255, 0.85);

            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.18),
                inset 0 1px 0 rgba(255, 255, 255, 0.55);
        }

        /* ================= TEXT & BADGES ================= */

        .feed-left h3 {
            font-size: 20px;
            margin-bottom: 6px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .feed-left p {
            font-size: 14.5px;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .read-tag b {
            color: var(--item-color);
            filter: brightness(0.9);
        }

        .feed-right {
            display: flex;
            align-items: center;

            padding: 8px 16px;
            border-radius: 100px;

            background: color-mix(in srgb, var(--item-color) 15%, transparent);

            border: 1.5px solid var(--item-color);
            color: var(--item-color);

            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;

            white-space: nowrap;

            box-shadow:
                0 0 0 1px rgba(255, 255, 255, 0.4) inset,
                0 4px 12px
                    color-mix(in srgb, var(--item-color) 25%, transparent);
        }

        /* ================= DARK MODE ================= */

        body.dark .feed-wrapper {
            background: rgba(18, 22, 28, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        body.dark .feed-item {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.1);
            border-left-color: var(--item-color);
        }

        body.dark .feed-item:hover {
            background: rgba(255, 255, 255, 0.12);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        }

        body.dark .feed-right {
            background: rgba(0, 0, 0, 0.2);
            color: var(--item-color);
            border-color: var(--item-color);
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--item-color);
            box-shadow: 0 0 10px var(--item-color);
            flex-shrink: 0;
        }
        /* ================= MOBILE OPTIMIZATION (UPGRADED) ================= */

        @media (max-width: 768px) {
            .blog-feed {
                padding-top: 20px;
                margin-bottom: 40px;
            }

            .feed-wrapper {
                padding: 24px 16px; /* Reduced side padding for more text room */
                border-radius: 20px;
                margin: 0 10px; /* Small margin so it doesn't touch screen edges */
            }

            .feed-header {
                flex-direction: row;
                align-items: flex-start;
                gap: 15px;
                margin-bottom: 25px;
            }

            .feed-title {
                font-size: 20px;
            }

            .category-dropdown {
                width: 100%; /* Full width dropdown for easier tapping */
                text-align: center;
            }

            .feed-list {
                max-height: 650px; /* Slightly shorter for mobile viewports */
                gap: 12px;
                padding-right: 0;
                margin-right: 0;
            }

            .feed-item {
                flex-direction: column; /* Stack Title/Text above the Tag */
                align-items: flex-start;
                padding: 20px;
                gap: 15px;
            }

            .feed-item:hover {
                transform: translateY(-2px) scale(1.01); /* Gentler hover for touch */
            }

            .feed-left h3 {
                font-size: 22px;
            }

            .feed-left p {
                font-size: 13.5px;
                max-width: 100%; /* Use full width on mobile */
            }

            .feed-right {
                align-self: flex-start;
                padding: 10px 20px; /* Larger touch target */
                font-size: 11px;
            }

            /* Fix for Topic Grid on Mobile */
            .blog-grid {
                grid-template-columns: 1fr; /* Single column */
                gap: 20px;
                padding: 0 10px;
            }

            .topic-card .card-inner {
                padding: 30px 20px;
            }

            .card-text h3 {
                font-size: 22px;
            }

            .card-art {
                width: 140px; /* Smaller art so it doesn't overlap text */
                top: -10px;
                right: -10px;
            }
        }

        /* Smallest phones fix */
        @media (max-width: 480px) {
            .feed-wrapper {
                padding: 20px 12px;
            }

            .feed-item {
                padding: 16px;
            }
        }
        body.dark .filter-trigger {
  background: rgba(30,34,44,0.85);
  border: 1px solid rgba(255,255,255,0.1);
}

body.dark .filter-menu {
  background: rgba(20,24,32,0.95);
  border: 1px solid rgba(255,255,255,0.1);
}
    </style>
</BaseLayout>
