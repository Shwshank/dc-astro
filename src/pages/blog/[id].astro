---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTemplate from "../../components/BlogTemplate.astro";
import CTA from "../../components/CTA.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/*.{jpeg,jpg,png,gif,webp}",
);

const blogFallbackImageName = "delhi_hero";

export async function getStaticPaths() {
    const blogEntries = await getCollection("blog");

    return blogEntries.map((entry) => ({
        // Use entry.id explicitly
        params: { id: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const heroImagePath = Object.entries(images).find(([path]) => {
    const fileName = path.split("/").pop()?.split(".")[0].toLowerCase();
    return fileName === entry.data.heroImage?.toLowerCase();
});

const imageMap = images;

// 1. Reusable helper function
const resolveImage = async (imageName: string | undefined) => {
    if (!imageName) return null;

    const entries = Object.entries(images);

    // Helper to find a match based on filename
    const findMatch = (name: string) =>
        entries.find(([path]) => {
            const fileName = path.split("/").pop()?.split(".")[0].toLowerCase();
            return fileName === name.toLowerCase();
        });

    let match = findMatch(imageName);

    // Fallback logic if the primary image isn't found
    if (!match && blogFallbackImageName) {
        console.warn(
            `⚠️ Image "${imageName}" not found, using fallback "${blogFallbackImageName}"`,
        );
        match = findMatch(blogFallbackImageName);
    }

    return match ? (await match[1]()).default : null;
};

const heroImageResolved = await resolveImage(entry.data.heroImage);

const galleryImageResolved = await Promise.all(
    (entry.data.gallery ?? []).map((img: any) => resolveImage(img)),
).then((arr) => arr.filter(Boolean));

const nextBlogImageResolved = entry.data.nextBlog?.image1
    ? await resolveImage(entry.data.nextBlog.image1)
    : undefined;

const nextBlogImage2Resolved = entry.data.nextBlog?.image2
    ? await resolveImage(entry.data.nextBlog.image2)
    : undefined;

const nextBlogData = entry.data.nextBlog;

// Dynamic blog

// 1. Get all blog posts
const allPosts = await getCollection("blog");

// 2. Filter out the current post
const otherPosts = allPosts.filter((p) => p.id !== entry.id);

// --- SLOT 1: SAME CATEGORY (The "Deep Dive") ---
const sameCategoryPosts = otherPosts
    .filter((p) => p.data.category === entry.data.category)
    .sort(() => Math.random() - 0.5); // Shuffle for variety

const slot1 = sameCategoryPosts.length > 0 
    ? sameCategoryPosts[0] 
    : otherPosts[0]; // Fallback to any post if category is empty

// --- SLOT 2: DIFFERENT CATEGORY (The "Discovery") ---
const differentCategoryPosts = otherPosts
    .filter((p) => p.data.category !== entry.data.category)
    .sort(() => Math.random() - 0.5); // Shuffle for variety

const slot2 = differentCategoryPosts.length > 0 
    ? differentCategoryPosts[0] 
    : sameCategoryPosts[1]; // Fallback to a 2nd same-category post if only 1 category exists

// 3. Combine into the final array
const relatedPosts = [slot1, slot2].filter(Boolean);

const dynamicNextBlogs = await Promise.all(
    relatedPosts.map(async (post) => {
        return {
            title: post.data.title,
            description: post.data.seoDescription, // or a summary field
            link: `/blog/${post.id}`,
            image: await resolveImage(post.data.heroImage),
            category: post.data.category,
        };
    }),
);


---

<BaseLayout
    title={entry.data.title}
    seoTitle={entry.data.seoTitle}
    seoDescription={entry.data.seoDescription}
>
    <BlogTemplate
        title={entry.data.title}
        heroImage={heroImageResolved}
        gallery={galleryImageResolved}
        breadcrumbs={[
            { label: "Home", href: "/" },
            { label: "Blog", href: "/blog" },
            { label: entry.data.title },
        ]}
        category={entry.data.category}
        date={entry.data.pubDate.toDateString()}
        author={entry.data.author}
        readTimeInMinutes={5}
        cta={{
            title: "Move smarter, not harder.",
            description:
                "Delhi Concierge helps you navigate pricing, movement, and decisions with clarity.",
            buttonText: "Explore Delhi Mindfull",
            link: "/services",
        }}
        finalThought={{
            title: "Final Thought",
            unbiased_opinion: entry.data.finalThought_unbiased_opinion,
        }}
        nextBlog={{
            title1: dynamicNextBlogs[0]?.title,
            description1: dynamicNextBlogs[0]?.description,
            link1: dynamicNextBlogs[0]?.link,
            image1: dynamicNextBlogs[0]?.image,
            category1: dynamicNextBlogs[0]?.category,

            title2: dynamicNextBlogs[1]?.title,
            description2: dynamicNextBlogs[1]?.description,
            link2: dynamicNextBlogs[1]?.link,
            image2: dynamicNextBlogs[1]?.image,
            category2: dynamicNextBlogs[1]?.category,
        }}
    >
        <!-- 🔥 THIS IS THE MAGIC -->
        <article class="blog-content">
            <Content />
        </article>
    </BlogTemplate>

    <CTA />
</BaseLayout>
