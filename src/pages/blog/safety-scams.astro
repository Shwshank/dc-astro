---
import BlogCategoryTemplate from "../../components/BlogCategoryTemplate.astro";
import heroImage from "../../assets/images/market-2.webp";
import scam from "../../assets/images/market.jpg";
import night from "../../assets/images/nighttraffic.jpg";
import police from "../../assets/images/traffic.jpg";
import money from "../../assets/images/6.png";
import metro from "../../assets/images/metro.png";
import nighttraffic from "../../assets/images/nighttraffic.jpg";
import market2 from "../../assets/images/market-2.webp";
import market from "../../assets/images/market.jpg";
import traffic from "../../assets/images/traffic.jpg";

/* CATEGORY META */
const category = "Safety & Scams";
const description =
    "Stay aware without paranoia. Real-world insights into scams, safety patterns, and how to move confidently through Delhi.";

/* BLOG DATA */
const allPosts = [
    {
        title: "Is Delhi Safe at Night? What Actually Matters",
        excerpt: "Forget myths. Here’s what truly affects your safety.",
        href: "/blog/delhi-night-safety-guide",
        image: nighttraffic,
    },
    {
        title: "Tourist Scams in Delhi (And How to Avoid Them)",
        excerpt: "The most common traps and how to spot them instantly.",
        href: "/blog/delhi-tourist-scams-guide",
        image: market2,
    },
    {
        title: "Is Street Food Safe in Delhi? How to Eat Smart Without Getting Sick",
        excerpt:
            "A practical guide to choosing clean vendors, avoiding common mistakes, and enjoying street food safely.",
        href: "/blog/delhi-street-food-safety-guide",
        image: market,
    },
    {
        title: "Where to Stay Safe During Rainstorms & Emergencies in Delhi",
        excerpt:
            "From sudden downpours to unexpected situations—where to go, what to avoid, and how to stay in control.",
        href: "/blog/delhi-rain-emergency-safety-guide",
        image: traffic,
    },
    {
        title: "Police & Uniformed Officers in Delhi: What Tourists Should Know",
        excerpt:
            "How to identify real officers, what they can and cannot do, and how to handle interactions confidently.",
        href: "/blog/delhi-police-tourist-guide",
        image: traffic,
    },
];

/* PAGINATION */
const postsPerPage = 6;
const currentPage = 1;

const totalPages = Math.ceil(allPosts.length / postsPerPage);

const posts = allPosts.slice(
    (currentPage - 1) * postsPerPage,
    currentPage * postsPerPage,
);
---

<BlogCategoryTemplate
    heroImage={heroImage}
    category="Safety & Scams"
    description="Stay aware without paranoia. Learn how to avoid scams and navigate Delhi with confidence."
    posts={posts}
    currentPage={currentPage}
    totalPages={totalPages}
    baseUrl="/blog/safety-scams"
    breadcrumb={[
        { label: "Home", href: "/" },
        { label: "Blog", href: "/blog" },
        { label: "Safety & Scams" },
    ]}
/>
