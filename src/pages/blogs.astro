---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
---

<BaseLayout title="Blog | Delhi Concierge">

    <!-- Hero -->

    <!-- BLOG CATEGORIES -->

    <section class="section">
        <div class="container">
            <h2 class="blog-title">Browse by Topic</h2>

            <div class="blog-grid">
                <!-- CARD 1 -->

                <a href="/blogs/delhi-survival-guide" class="blog-card survival">
                    <svg class="card-art" viewBox="0 0 200 200">
                        <circle cx="100" cy="100" r="80"></circle>
                    </svg>

                    <h3>Delhi Survival Guide</h3>

                    <p>
                        Practical knowledge for navigating everyday life in
                        Delhi — transportation, useful apps, payments,
                        neighbourhoods, and avoiding the most common mistakes
                        newcomers make.
                    </p>

                    <span class="meta">
                        Transport • SIM cards • Food • Local apps
                    </span>

                    <span class="read"> Read guides → </span>
                </a>

                <!-- CARD 2 -->

                <a href="/blogs/safety-scam-awareness" class="blog-card safety">
                    <svg class="card-art" viewBox="0 0 200 200">
                        <path d="M20 100 L100 20 L180 100 L100 180 Z"></path>
                    </svg>

                    <h3>Safety & Scam Awareness</h3>

                    <p>
                        Delhi is vibrant but can overwhelm first-time visitors.
                        Learn how common scams work, where travelers get misled,
                        and how to navigate situations confidently.
                    </p>

                    <span class="meta">
                        Taxi scams • Fake guides • Tourist traps
                    </span>

                    <span class="read"> Read guides → </span>
                </a>

                <!-- CARD 3 -->

                <a href="/blogs/cultural-decoding" class="blog-card culture">
                    <svg class="card-art" viewBox="0 0 200 200">
                        <circle cx="60" cy="100" r="30"></circle>
                        <circle cx="140" cy="100" r="30"></circle>
                    </svg>

                    <h3>Cultural Decoding</h3>

                    <p>
                        India can feel culturally complex. These articles
                        explain everyday behaviors, social expectations, and
                        cultural signals visitors often misunderstand.
                    </p>

                    <span class="meta">
                        Etiquette • Social signals • Cultural habits
                    </span>

                    <span class="read"> Read guides → </span>
                </a>

                <!-- CARD 4 -->

                <a href="/blogs/concierge-insights" class="blog-card concierge">
                    <svg class="card-art" viewBox="0 0 200 200">
                        <path d="M40 160 Q100 40 160 160"></path>
                    </svg>

                    <h3>Concierge Insights</h3>

                    <p>
                        Behind-the-scenes insights from working as a concierge
                        in Delhi — patterns we see with travelers, common
                        problems, and how experienced locals solve them.
                    </p>

                    <span class="meta">
                        Real experiences • Travel insights • Local strategies
                    </span>

                    <span class="read"> Read guides → </span>
                </a>
            </div>
        </div>
    </section>

    <!-- REUSE EXISTING CTA COMPONENT -->

    <CTA />

    <style>
        /* BLOG GRID */

        .blog-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .blog-card {
            background: var(--bg-surface);
            padding: 26px;
            border-radius: var(--radius-md);

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.06),
                inset 0 1px 0 rgba(255, 255, 255, 0.4);

            transition: 0.25s;
        }

        .blog-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 55px rgba(0, 0, 0, 0.12);
        }

        .blog-card h3 {
            margin-bottom: 10px;
            font-size: 20px;
        }

        .blog-card p {
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .blog-meta {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .blog-link {
            text-decoration: none;
            font-weight: 500;
            color: var(--accent-blue);
        }

        .blog-link:hover {
            text-decoration: underline;
        }

        /* RESPONSIVE */

        @media (min-width: 780px) {
            .blog-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        /* ================= BLOG PREMIUM GRID ================= */

        .blog-title {
            margin-bottom: 28px;
            font-size: 26px;
        }

        .blog-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 26px;
        }

        /* ================= GLASS CARD ================= */

        .blog-card {
            position: relative;
            display: block;

            padding: 30px;
            border-radius: 24px;

            text-decoration: none;
            color: var(--text-primary);

            background: linear-gradient(
                160deg,
                rgba(255, 255, 255, 0.08),
                rgba(255, 255, 255, 0.02)
            );

            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);

            border: 1px solid rgba(255, 255, 255, 0.08);

            box-shadow:
                0 30px 60px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.06);

            transition: 0.35s var(--ease);

            overflow: hidden;
        }

        /* glow layer */

        .blog-card::before {
            content: "";
            position: absolute;
            inset: -1px;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.25),
                    transparent 50%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(238, 142, 67, 0.2),
                    transparent 55%
                );

            opacity: 0.35;
            filter: blur(30px);

            z-index: -1;
        }

        /* hover */

        .blog-card:hover {
            transform: translateY(-10px);

            box-shadow:
                0 50px 100px rgba(0, 0, 0, 0.55),
                inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }

        /* svg design */

        .card-art {
            position: absolute;
            top: -20px;
            right: -10px;

            width: 160px;
            height: 160px;

            stroke: rgba(255, 255, 255, 0.08);
            stroke-width: 2;
            fill: none;

            opacity: 0.35;
        }

        /* text */

        .blog-card h3 {
            margin-bottom: 10px;
            font-size: 20px;
        }

        .blog-card p {
            color: var(--text-secondary);
            margin-bottom: 14px;
        }

        .meta {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .read {
            color: var(--accent-blue);
            font-weight: 500;
        }

        /* ================= RESPONSIVE ================= */

        @media (min-width: 780px) {
            .blog-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (min-width: 1100px) {
            .blog-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        /* ================= BLOG CARDS LIGHT MODE FIX ================= */

        body:not(.dark) .blog-card {
            background: linear-gradient(
                160deg,
                rgba(255, 255, 255, 0.85),
                rgba(255, 255, 255, 0.35)
            );

            border: 1px solid rgba(0, 0, 0, 0.06);

            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.8);
        }

        /* ambient glow layer */

        body:not(.dark) .blog-card::before {
            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(92, 204, 251, 0.25),
                    transparent 55%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(238, 142, 67, 0.25),
                    transparent 60%
                );

            opacity: 0.45;
        }

        /* svg art visibility */

        body:not(.dark) .card-art {
            stroke: rgba(0, 0, 0, 0.12);
            opacity: 0.35;
        }

        /* hover depth */

        body:not(.dark) .blog-card:hover {
            box-shadow:
                0 35px 70px rgba(0, 0, 0, 0.15),
                inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }
        .card-art {
            stroke-width: 2;
            fill: none;
        }
    </style>
</BaseLayout>
