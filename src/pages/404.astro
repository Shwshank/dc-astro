---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | DelhiConcierge">

<section class="section error-section">

<div class="container error-container">

<div class="error-glow"></div>

<div class="glass-card error-card">

<h1 class="error-code">404</h1>

<h2 class="error-title">
Page not found on 
<span class="brand-delhi">Delhi</span><span class="brand-concierge">Concierge</span>
</h2>

<p class="error-text">
The page you’re looking for may have moved or no longer exists.
You can continue exploring Delhi using the links below.
</p>

<div class="error-actions">

<a href="/" class="btn-primary">Go Home</a>

<a href="/navigate-delhi" class="btn-secondary">
Navigate Delhi
</a>

</div>

</div>

</div>

</section>



<style>

/* SECTION */

.error-section{
min-height:70vh;
display:flex;
align-items:center;
justify-content:center;
}



/* CONTAINER */

.error-container{
position:relative;
text-align:center;
max-width:720px;
}



/* GLASS CARD */

.glass-card{

background:rgba(255,255,255,.5);
backdrop-filter:blur(18px);

border:1px solid var(--border-soft);
border-radius:18px;

padding:48px 36px;

}



/* ERROR TEXT */

.error-code{
font-size:72px;
margin-bottom:8px;
}

.error-title{
margin-bottom:14px;
}

.error-text{
color:var(--text-secondary);
max-width:480px;
margin:auto;
}



/* BRAND */

.brand-delhi{
color:var(--text-primary);
font-weight:700;
}

.brand-concierge{
color:var(--text-primary);
opacity:.6;
font-weight:500;
}



/* BUTTONS */

.error-actions{
margin-top:26px;
display:flex;
gap:16px;
justify-content:center;
flex-wrap:wrap;
}

.btn-primary{

padding:12px 22px;

border-radius:10px;
background:linear-gradient(135deg,#ff8c40,#ff6a2a);

color:white;
text-decoration:none;

font-weight:600;

}

.btn-secondary{

padding:12px 22px;

border-radius:10px;

border:1px solid var(--border-soft);
background:var(--bg-surface);

text-decoration:none;
color:var(--text-primary);

}



/* BLUE GLOW */

.error-glow{

position:absolute;

width:700px;
height:700px;

top:50%;
left:50%;

transform:translate(-50%,-50%);

background:
radial-gradient(circle,
rgba(90,160,255,.25),
transparent 70%);

filter:blur(120px);

z-index:-1;

}



/* DARK MODE */

body.dark .glass-card{
background:rgba(18,22,32,.6);
border:1px solid rgba(255,255,255,.08);
}



/* MOBILE */

@media (max-width:700px){

.error-code{
font-size:56px;
}

.glass-card{
padding:32px 22px;
}

}

</style>

</BaseLayout>